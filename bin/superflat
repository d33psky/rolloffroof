#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["numpy", "astropy", "scipy", "matplotlib"]
# ///
"""superflat - build a night-sky flat from the science sub exposures themselves.

A panel flat is lit by a panel, not by the sky, so it gets the large-scale
illumination of the real light path wrong - which is where the rings, the
central hole and the vignetting mismatch come from. The sky itself is the only
light source that follows the true path, and every light frame is a picture of
it. Combine enough frames and the sky is all that is left.

WHAT IT DOES
  Takes RAW subs (as KStars writes them), in raw sensor geometry - no
  registration, no alignment, no plate solving. Per frame:
    1. subtract the matching master dark (removes bias + dark structure, which
       are additive and would otherwise be read as response)
    2. mask the bad pixels from the BPM (a hot pixel sits at the same sensor
       pixel in every frame, so no amount of dithering removes it)
    3. divide by the frame's own sky level, so 60 s and 300 s frames and bright
       and dark nights all carry the same weight
    4. subtract a fitted plane and add 1 back: moonlight and light-pollution
       gradients are linear over a 48 arcmin field and would average into the
       flat, while vignetting, rings and the hole are not linear and survive
  and then combines the frames pixel by pixel with a median that also rejects
  the high side (stars are only ever too bright, never too faint).

  Frames MUST come from several different targets, and in roughly equal shares.
  That is what removes the objects, NOT dithering: with N targets contributing
  equally, a star of one target sits on its sensor pixel in only 1/N of the
  frames, which a median absorbs for N >= 3. Dithering helps on top of that by
  smearing each target's own stars over a few tens of pixels, but it is not
  required and has not always worked - the real dither is measured during
  selection, by cross correlating consecutive subs, so you can see which
  sessions actually dithered.

EQUIPMENT KEY (checked, never assumed)
  Only frames sharing camera, focal length, binning and camera clocking can go
  into one superflat. Clocking is CROTA2 mod 180: on an equatorial mount the
  sky orientation on the sensor does not depend on the target, so that angle is
  the camera's rotation in the optical train. Frames outside --clock-tol of the
  reference are dropped (the train was re-clocked in Nov/Dec 2025: everything
  before sits near 86-91 deg, everything after near 74 deg).
  Pier side is NOT a key by default: in sensor coordinates the optics do not
  rotate, only the sky does, so mixing east and west frames actually cancels
  the sky better. Use --pier to build one side only, as a diagnostic of whether
  the signature itself moves with the flip.

USING THE RESULT
  The output has the geometry of a sub, so it can go straight into APP as a
  master flat. The sound recipe combines both flats by scale:
      master = large_scale(superflat) x [panel / large_scale(panel)]
  small scale (pixel response, sharp dust) from the panel flat, illumination
  from the sky. --illum writes that combination when a panel flat is given.

VALIDATION
  --halves builds two superflats from disjoint halves of the frames and reports
  how much they differ. That is the honest measure of whether the signature is
  stable: if the halves disagree, no single flat can be right, and the split
  can then be narrowed down with --pier, --since/--until or --alt-range.

EXAMPLES
  superflat NGC_6285 NGC_6043 NGC_4205 NGC_5907 M_86 --filter Lum
  superflat NGC_6285 NGC_6043 NGC_4205 --filter Lum --write --halves --plot
  superflat NGC_6285 NGC_6043 --filter Lum --pier east --write --name east
  superflat NGC_6285 --filter Lum --alt-range 20 45 --write --name lowalt
"""

import argparse
import glob
import concurrent.futures as cf
import os
import re
import sys
from collections import defaultdict, Counter
from datetime import datetime

import numpy as np
from astropy.io import fits
from scipy import ndimage

DATA_ROOT = os.path.expanduser('~/astro/data')
OUT_ROOT = os.path.expanduser('~/astro/data/superflat')
FITS_EXT = ('.fits', '.fit', '.fts')
# filter directory names differ per session (Lum / Luminance, Ha / Hydrogen-alpha)
FILTER_ALIAS = {'lum': ('lum', 'luminance', 'l'), 'red': ('red', 'r'),
                'green': ('green', 'g'), 'blue': ('blue', 'b'),
                'ha': ('ha', 'halpha', 'h-alpha', 'hydrogen-alpha'),
                'oiii': ('oiii', 'o3'), 'sii': ('sii', 's2')}
MASK_BAND = 400e6           # bytes of frame data held at once
CUBE_SCALE = 20000.0        # (value - 1) x this, stored as int16
MASKED = 32767              # sentinel: above anything real, so always clipped


def mem_available():
    try:
        with open('/proc/meminfo') as fh:
            for line in fh:
                if line.startswith('MemAvailable:'):
                    return int(line.split()[1]) * 1024
    except Exception:
        pass
    return 2e9


def slug(s):
    return re.sub(r'[^A-Za-z0-9]+', '_', str(s)).strip('_')


def equip_key(h):
    """camera-focallen-binning, from the header"""
    cam = slug(h.get('INSTRUME', 'unknown')).replace('ZWO_CCD_', '')
    return f"{cam}-fl{int(round(float(h.get('FOCALLEN', 0))))}-bin{h.get('XBINNING', '?')}"


def clocking(h):
    """camera rotation in the optical train = CROTA2 mod 180 (equatorial mount:
    the sky orientation on the sensor does not depend on the target)"""
    r = h.get('CROTA2')
    return float(r) % 180 if r is not None else None


def filter_dirs(light_dir, want):
    names = FILTER_ALIAS.get(want.lower(), (want.lower(),))
    out = []
    for d in sorted(glob.glob(light_dir + '/*')):
        if os.path.isdir(d) and os.path.basename(d).lower() in names:
            out.append(d)
    return out


def keep_list(target):
    """basenames sort-subs called good, if --write was ever run on this object"""
    p = os.path.join(target, 'sub-metrics-verdicts', 'keep.txt')
    if not os.path.exists(p):
        return None
    with open(p) as fh:
        return {os.path.basename(l.strip()) for l in fh if l.strip()}


def collect(targets, filt):
    """All candidate frames per target: only from Light/ (never Light_rejected/),
    restricted to sort-subs' keep list when there is one. No sampling here - the
    equipment filter has to run first, or a target holding an old campaign shot
    with another camera (M-101 has 1382 ASI1600 frames from 2022 next to 30
    current ones) spends its whole quota on frames that get dropped after."""
    out = {}
    for t in targets:
        tdir = t if os.path.isdir(t) else os.path.join(DATA_ROOT, t)
        if not os.path.isdir(tdir):
            print(f'  {t}: not a directory, skipped', file=sys.stderr)
            continue
        keep = keep_list(tdir)
        files = []
        for light in sorted(glob.glob(tdir + '/Light')) + sorted(glob.glob(tdir + '/*/Light')):
            for fd in filter_dirs(light, filt):
                for f in sorted(os.listdir(fd)):
                    if not f.lower().endswith(FITS_EXT):
                        continue
                    if keep is not None and f not in keep:
                        continue
                    files.append(os.path.join(fd, f))
        if not files:
            print(f'  {tdir}: no {filt} frames', file=sys.stderr)
            continue
        out[tdir] = (files, keep is not None)
    return out


def spread_over_nights(files, want):
    """pick `want` frames spread evenly over the nights they came from"""
    by_night = defaultdict(list)
    for f in files:
        m = re.search(r'(\d{4}-\d{2}-\d{2})T', os.path.basename(f))
        by_night[m.group(1) if m else '?'].append(f)
    nights = sorted(by_night)
    picked, i = [], 0
    while len(picked) < want and any(by_night.values()):
        n = nights[i % len(nights)]
        if by_night[n]:
            picked.append(by_night[n].pop(len(by_night[n]) // 2))
        i += 1
        if i > 200000:
            break
    return sorted(picked), len(nights)


def find_master(tdir, kind, cam_dims, gain=None, exptime=None, pool=None):
    """APP master frames sit in a target dir:
       MD-IG_<gain>-E<exp>s-<cam>-<w>x<h>[-all_channels].fits, BPM-<cam>-<w>x<h>.fits
    Look in the frame's own target first, then anywhere else under the data
    root: a session that shot 300 s subs often has no 300 s dark of its own,
    while another target does, and the dark only has to match camera, binning,
    gain and exposure - not the target."""
    def matches(f):
        b = os.path.basename(f)
        if not b.startswith(kind + '-') or cam_dims not in b:
            return False
        if gain is not None and f'IG_{gain:.1f}' not in b:
            return False
        if exptime is not None and not re.search(rf'-E{exptime:g}(\.0)?s-', b):
            return False
        return True

    for f in sorted(glob.glob(os.path.join(tdir, f'{kind}-*.fits'))):
        if matches(f):
            return f
    for f in (pool or []):
        if matches(f):
            return f
    return None


def master_pool(root):
    """every APP master under the data root, for the cross-target fallback"""
    return sorted(glob.glob(os.path.join(root, '*', 'M*-*.fits')) +
                  glob.glob(os.path.join(root, '*', 'BPM-*.fits')) +
                  glob.glob(os.path.join(root, '*', '*', 'M*-*.fits')))


def star_map(a):
    hp = a - ndimage.median_filter(a, 7)
    sig = float(np.median(np.abs(hp)) * 1.4826)
    return np.clip(hp / max(sig, 1e-6) - 4, 0, 30)


def measure_dither(files, n=16):
    """Real dither, in pixels: the star field shift between consecutive subs of
    one night, by FFT cross correlation. NOT from CRVAL - that is the mount's
    reported pointing, which shows the offsets that were commanded, not the ones
    the guider actually let happen (measured 2026-08-26: three targets reported
    dither steps while their stars never moved)."""
    by_night = defaultdict(list)
    for f in files:
        m = re.search(r'(\d{4}-\d{2}-\d{2})T', os.path.basename(f))
        by_night[m.group(1) if m else '?'].append(f)
    if not by_night:
        return None
    night = max(by_night, key=lambda k: len(by_night[k]))
    # consecutive frames of that night, taken from the directory itself: the
    # superflat's own selection is spread out and would miss a dither that only
    # happens every few frames
    d = os.path.dirname(by_night[night][0])
    fs = sorted(f for f in glob.glob(d + '/*')
                if os.path.basename(f).startswith(night) and f.lower().endswith(FITS_EXT))
    fs = fs[len(fs) // 3:][:n]
    if len(fs) < 4:
        return None
    steps, prev = [], None
    for f in fs:
        sm = star_map(fits.getdata(f).astype(np.float32))
        if prev is not None and sm.shape == prev.shape:
            A, B = np.fft.rfft2(sm), np.fft.rfft2(prev)
            r = np.fft.irfft2(A * np.conj(B), s=sm.shape)
            dy, dx = np.unravel_index(np.argmax(r), r.shape)
            dy -= sm.shape[0] if dy > sm.shape[0] // 2 else 0
            dx -= sm.shape[1] if dx > sm.shape[1] // 2 else 0
            steps.append(float(np.hypot(dx, dy)))
        prev = sm
    return steps or None


def source_mask_frame(d, cell=128, nsig=3.0, grow=8):
    """Pixels that are bright IN THIS FRAME relative to its own local
    background: stars, and the target object. Every target is centred in its
    own frames, so without this the objects of all targets pile up on the same
    part of the sensor and no amount of combining removes them. The background
    is a coarse block median, so only structure smaller than ~2 cells is
    masked - the flat's own rings and vignetting are far larger and survive."""
    H, W = d.shape
    hy, hx = H // cell, W // cell
    blocks = d[:hy * cell, :hx * cell].reshape(hy, cell, hx, cell)
    coarse = np.median(blocks, axis=(1, 3))
    bg = ndimage.zoom(coarse, (H / hy, W / hx), order=1)[:H, :W]
    resid = d - bg
    sig = float(np.median(np.abs(resid)) * 1.4826)
    m = resid > nsig * max(sig, 1e-9)
    # box blur instead of iterated binary dilation: same effect, O(1) per pixel
    return ndimage.uniform_filter(m.astype(np.float32), 2 * grow + 1) > 0


def frame_scale_and_plane(d, valid):
    """sky level and the linear gradient of one dark-subtracted frame, both from
    a subsample of the faint pixels (objects excluded)"""
    sub = d[::7, ::7]
    v = sub[np.isfinite(sub)]
    med = float(np.median(v))
    sig = float(np.median(np.abs(v - med)) * 1.4826)
    ys, xs = np.nonzero((sub < med + 2 * sig) & (sub > med - 5 * sig))
    z = sub[ys, xs]
    H, W = d.shape
    xn = (xs * 7 - W / 2) / W
    yn = (ys * 7 - H / 2) / H
    A = np.stack([np.ones_like(xn, float), xn, yn], axis=1)
    coef, *_ = np.linalg.lstsq(A, z, rcond=None)
    return med, coef


def plane_image(coef, shape):
    H, W = shape
    y, x = np.mgrid[0:H, 0:W]
    xn = (x - W / 2) / W
    yn = (y - H / 2) / H
    return coef[0] + coef[1] * xn + coef[2] * yn


def combine(raw):
    """Per-pixel median of the frames that have valid data there, with the high
    side clipped away (objects only ever add light).

    Masked pixels are missing data, NOT a large value to be clipped: every
    target is centred in its own frames, so near the sensor centre a majority of
    frames can be masked at once, and a sentinel would then become the median
    itself. Returns the result and the number of frames that contributed, so
    that thin coverage is visible instead of silently interpolated."""
    band = raw.astype(np.float32)
    band[band >= MASKED] = np.nan
    band = band / CUBE_SCALE + 1.0
    with np.errstate(invalid='ignore'):
        med = np.nanmedian(band, axis=0)
        # sigma from a subsample rather than a per-pixel MAD: the sky noise
        # varies slowly across the sensor, and the per-pixel version needs a
        # second full-size nanmedian plus a full-size temporary
        samp = np.abs(band[::3, ::4, ::4] - med[::4, ::4])
        sig = float(np.nanmedian(samp) * 1.4826) if np.isfinite(samp).any() else 0.0
        band[band > med + 2.5 * max(sig, 1e-6)] = np.nan
        out = np.nanmedian(band, axis=0)
    count = np.count_nonzero(np.isfinite(band), axis=0)
    return out, count


def load_bpm(path):
    """APP's bad pixel map is uint8 with 127 = good and 255 = bad - it never
    contains 0, so a plain astype(bool) marks the whole sensor bad. Take the
    most common value as 'good' and everything else as bad."""
    d = fits.getdata(path)
    vals, counts = np.unique(d, return_counts=True)
    good = vals[int(np.argmax(counts))]
    bad = d != good
    frac = float(bad.mean())
    if frac > 0.2:
        print(f'  bad pixel map marks {100 * frac:.1f}% of the sensor bad - ignoring it',
              file=sys.stderr)
        return None, frac
    return bad, frac


def smooth_fill(img, bad, sigma=30):
    """Fill masked pixels by normalised convolution: the surrounding values,
    Gaussian weighted. Nearest-neighbour filling propagates one pixel's value
    across a whole hole and invents blocky rings - visible in the first 8-target
    build, where the objects of all targets overlap at the sensor centre."""
    if not bad.any():
        return img
    good = (~bad).astype(np.float32)
    v = np.where(bad, 0.0, img).astype(np.float32)
    for sig in (sigma, sigma * 3, sigma * 9):          # widen until every hole is covered
        num = ndimage.gaussian_filter(v, sig)
        den = ndimage.gaussian_filter(good, sig)
        filled = np.where(den > 1e-6, num / np.maximum(den, 1e-6), np.nan)
        out = np.where(bad, filled, img)
        if np.isfinite(out).all():
            return out
        v = np.where(np.isfinite(out), np.nan_to_num(out), 0.0)
        good = np.isfinite(out).astype(np.float32)
    return np.where(np.isfinite(out), out, float(np.nanmedian(img)))


def fill_bad(img, bad):
    """replace masked pixels by their surroundings (a hot pixel is at the same
    sensor position in every frame, so the median keeps it)"""
    if not bad.any():
        return img
    idx = ndimage.distance_transform_edt(bad, return_distances=False, return_indices=True)
    return img[tuple(idx)]


def write_out(path, data, meta, log):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    h = fits.Header()
    for k, v in meta.items():
        h[k[:8].upper()] = v
    hdu = fits.PrimaryHDU(data.astype(np.float32), h)
    hdu.header.add_history(f'superflat {datetime.now():%Y-%m-%d %H:%M}')
    for k, v in meta.items():
        hdu.header.add_history(f'  {k} = {v}')
    hdu.writeto(path, overwrite=True)
    log(f'  wrote {path}')


def plot(path, flat, halves, log, cov=None):
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    n = 2 + (1 if halves else 0) + (1 if cov is not None else 0)
    fig, axes = plt.subplots(1, n, figsize=(6.5 * n, 5))
    lo, hi = np.percentile(flat, [0.5, 99.5])
    im = axes[0].imshow(flat, origin='lower', cmap='coolwarm', vmin=lo, vmax=hi)
    plt.colorbar(im, ax=axes[0], fraction=0.03)
    axes[0].set_title(f'superflat  ({100 * (hi - lo):.2f}% p-t-p shown)')
    sm = ndimage.gaussian_filter(flat, 40)
    im = axes[1].imshow(flat - sm, origin='lower', cmap='coolwarm', vmin=-0.002, vmax=0.002)
    plt.colorbar(im, ax=axes[1], fraction=0.03)
    axes[1].set_title('fine structure (flat - 40px smooth)')
    if halves:
        d = halves[0] - halves[1]
        im = axes[2].imshow(d, origin='lower', cmap='coolwarm', vmin=-0.002, vmax=0.002)
        plt.colorbar(im, ax=axes[2], fraction=0.03)
        axes[2].set_title(f'half1 - half2  (rms {d.std():.5f})')
    if cov is not None:
        im = axes[n - 1].imshow(cov, origin='lower', cmap='viridis')
        plt.colorbar(im, ax=axes[n - 1], fraction=0.03)
        axes[n - 1].set_title(f'frames per pixel (min {int(cov.min())}) - the centre is where '
                              f'every target sits', fontsize=9)
    for a in axes:
        a.set_xticks([]); a.set_yticks([])
    plt.tight_layout(); plt.savefig(path, dpi=95)
    log(f'  plot: {path}')


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('targets', nargs='+', help='target directories (names under '
                                               f'{DATA_ROOT} or paths)')
    ap.add_argument('--filter', default='Lum', help='filter to build for (default Lum)')
    ap.add_argument('--per-target', type=int, default=200, metavar='N',
                    help='at most N frames per target, spread over its nights (default 200)')
    ap.add_argument('--pier', choices=['all', 'east', 'west'], default='all',
                    help='restrict to one side of the meridian (default all: in sensor '
                         'coordinates mixing them cancels the sky better)')
    ap.add_argument('--alt-range', nargs=2, type=float, metavar=('LO', 'HI'),
                    help='only frames with OBJCTALT in this range, to test whether the '
                         'signature moves with altitude (flexure)')
    ap.add_argument('--since', metavar='YYYY-MM-DD', help='only frames from this date on')
    ap.add_argument('--until', metavar='YYYY-MM-DD', help='only frames up to this date')
    ap.add_argument('--clock-tol', type=float, default=1.5, metavar='DEG',
                    help='allowed spread in camera clocking (CROTA2 mod 180) around the '
                         'most common value (default 1.5)')
    ap.add_argument('--threads', type=int, default=max(1, (os.cpu_count() or 2) - 1),
                    metavar='N', help='worker threads (numpy releases the GIL for the median '
                                      'and the filters, so threads really do help)')
    ap.add_argument('--min-frames', type=int, default=50, metavar='N',
                    help='refuse to build from fewer than N frames (default 50)')
    ap.add_argument('--no-dither-check', action='store_true',
                    help='skip the dither measurement (it reads ~10 frames per target)')
    ap.add_argument('--halves', action='store_true',
                    help='also build two superflats from disjoint halves and report their '
                         'difference: the stability check')
    ap.add_argument('--name', default='all', metavar='NAME',
                    help='output basename under <out-root>/<equipment>/<filter>/ (default all)')
    ap.add_argument('--out-root', default=OUT_ROOT, metavar='DIR')
    ap.add_argument('--scratch', metavar='DIR',
                    help='where to put the normalised frame cube (default <out-root>/.cache; '
                         'it is deleted afterwards, but on a snapshotted filesystem the space '
                         'stays in the snapshots, so /var/tmp may be the better choice)')
    ap.add_argument('--write', action='store_true',
                    help='write the FITS (default: select, report and stop)')
    ap.add_argument('--plot', action='store_true', help='write a diagnostics PNG')
    a = ap.parse_args()
    sys.stdout.reconfigure(line_buffering=True)
    log = print

    print(f'looking for {a.filter} frames:')
    cands = collect(a.targets, a.filter)
    if not cands:
        sys.exit('no frames found')
    allfiles = [f for fs, _ in cands.values() for f in fs]
    print(f'  {len(allfiles)} candidates in {len(cands)} targets, reading headers')

    def head(f):
        h = fits.getheader(f)
        return f, dict(key=equip_key(h), clock=clocking(h), pier=str(h.get('PIERSIDE', '?')),
                       alt=h.get('OBJCTALT'), exp=float(h.get('EXPTIME', 0)),
                       gain=float(h.get('GAIN', 0)),
                       dims=f"{h.get('NAXIS1')}x{h.get('NAXIS2')}",
                       night=str(h.get('DATE-OBS'))[:10], cam=str(h.get('INSTRUME')))

    with cf.ThreadPoolExecutor(a.threads) as ex:
        info = dict(ex.map(head, allfiles))

    keys = Counter(v['key'] for v in info.values())
    key = keys.most_common(1)[0][0]
    if len(keys) > 1:
        print('  equipment present: ' + ', '.join(f'{k} x{v}' for k, v in keys.most_common()))
    clocks = [v['clock'] for v in info.values() if v['key'] == key and v['clock'] is not None]
    ref = float(np.median(clocks)) if clocks else None

    def why_not(f):
        v = info[f]
        if v['key'] != key:
            return 'equipment'
        if ref is not None and v['clock'] is not None and abs(v['clock'] - ref) > a.clock_tol:
            return 'clocking'
        if a.pier != 'all' and not v['pier'].lower().startswith(a.pier[0]):
            return 'pier'
        if a.alt_range and not (a.alt_range[0] <= float(v['alt'] or -99) <= a.alt_range[1]):
            return 'altitude'
        if a.since and v['night'] < a.since:
            return 'date'
        if a.until and v['night'] > a.until:
            return 'date'
        return None

    print(f'\nselecting: equipment {key}' +
          (f', clocking {ref:.2f} +/- {a.clock_tol} deg' if ref is not None else ''))
    drop, sel, usable = Counter(), [], []
    for tdir, (fs, had_keep) in sorted(cands.items()):
        ok = []
        for f in fs:
            w = why_not(f)
            drop[w] += 1 if w else 0
            if not w:
                ok.append(f)
        picked, nights = spread_over_nights(ok, a.per_target)
        sel += picked
        usable += ok
        print(f'  {os.path.basename(tdir):12} {len(picked):4} of {len(ok):5} usable'
              f' over {nights:2} nights'
              + (f'   ({len(fs) - len(ok)} dropped)' if len(fs) != len(ok) else '')
              + ('  (keep list applied)' if had_keep else ''))
    if sum(drop.values()):
        print('  dropped: ' + ', '.join(f'{k} {v}' for k, v in drop.items() if k))
    print(f'selected {len(sel)} frames from {len({info[f]["night"] for f in sel})} nights, '
          f'pier ' + ', '.join(f'{k}:{v}' for k, v in
                               Counter(info[f]['pier'][0] for f in sel).items()))
    if len(sel) < a.min_frames:
        sys.exit(f'only {len(sel)} frames, below --min-frames {a.min_frames}')

    if not a.no_dither_check:
        print('\nactual dither (star-field shift between consecutive subs of one night):')
        for t in sorted({f.split('/Light')[0] for f in sel}):
            steps = measure_dither([f for f in usable if f.startswith(t)])
            if steps is None:
                print(f'  {os.path.basename(t):12} too few consecutive frames to tell')
                continue
            moved = [v for v in steps if v >= 2]
            print(f'  {os.path.basename(t):12} {len(moved)}/{len(steps)} steps moved, '
                  f'typical move {np.median(moved) if moved else 0:.1f} px'
                  + ('' if moved else '   (no dither in this sample)'))

    # --- master dark and bad pixel map, per (target, exposure)
    groups = defaultdict(list)
    for f in sel:
        tdir = f.split('/Light')[0]
        groups[(tdir, info[f]['exp'], info[f]['gain'], info[f]['dims'])].append(f)
    print('\ncalibration:')
    usable, darks = [], {}
    cam_dims = None
    pool = master_pool(DATA_ROOT)
    for (tdir, exp, gain, dims), fs in sorted(groups.items()):
        cam = slug(info[fs[0]]['cam']).replace('ZWO_CCD_', '')
        cam_dims = f'{cam}-{dims}'
        md = find_master(tdir, 'MD', cam_dims, gain, exp, pool)
        borrowed = '' if not md or md.startswith(tdir) else \
            f' (borrowed from {os.path.basename(os.path.dirname(md))})'
        print(f'  {os.path.basename(tdir):12} {len(fs):4} frames  {exp:g}s gain{gain:g} {dims}'
              f'  dark: {os.path.basename(md) if md else "NOT FOUND - skipped"}{borrowed}')
        if md:
            darks[(tdir, exp)] = md
            usable += fs
    sel = usable
    if not sel:
        sys.exit('no frames with a matching master dark')
    bpm_path = None
    for tdir in {f.split('/Light')[0] for f in sel}:
        bpm_path = bpm_path or find_master(tdir, 'BPM', cam_dims, pool=pool)
    print(f'  bad pixel map: {os.path.basename(bpm_path) if bpm_path else "none found"}')

    if not a.write:
        print('\n(dry run - use --write to build the superflat)')
        return

    # --- per frame: subtract the dark, normalise, flatten the gradient, and
    # park the result in a scratch cube. Reading the originals is the expensive
    # part and the 16-bit files cannot be memory-mapped (BZERO/BSCALE), so every
    # frame is read exactly once here and the combine works from the cube.
    print('\nmeasuring and normalising frames:')
    dark_cache = {}
    H, W = fits.getdata(darks[next(iter(darks))]).shape
    # the cube holds (value - 1) x CUBE_SCALE as int16: the frames sit within a
    # few percent of 1.0, so this keeps 5e-5 precision (the structure we chase
    # is ~2e-3) at half the bytes, and MASKED is a value no real pixel reaches,
    # so the combine's high-side clip rejects masked pixels automatically.
    need = len(sel) * H * W * 2
    avail = mem_available()
    if need < 0.5 * avail:
        print(f'  cube in RAM ({need / 1e9:.1f} GB of {avail / 1e9:.1f} GB available)')
        cube = np.empty((len(sel), H, W), np.int16)
        cube_path = None
    else:
        cache_dir = a.scratch or os.path.join(a.out_root, '.cache')
        os.makedirs(cache_dir, exist_ok=True)
        cube_path = os.path.join(cache_dir, f'{key}-{a.filter}-{os.getpid()}.i16')
        print(f'  cube on disk: {cube_path} ({need / 1e9:.1f} GB, removed afterwards; '
              f'only {avail / 1e9:.1f} GB RAM available)')
        cube = np.memmap(cube_path, np.int16, 'w+', shape=(len(sel), H, W))
    for (tdir, exp), dp in darks.items():          # preload: threads must not race
        if dp not in dark_cache:
            dark_cache[dp] = fits.getdata(dp).astype(np.float32)

    def prepare(item):
        """read one frame, normalise it, mask its sources, park it in the cube"""
        i, f = item
        dp = darks[(f.split('/Light')[0], info[f]['exp'])]
        d = fits.getdata(f).astype(np.float32) - dark_cache[dp]
        med, coef = frame_scale_and_plane(d, None)
        if med <= 0:
            return i, None, None
        d /= med
        d -= plane_image(coef, (H, W)) / med
        d += 1.0
        m = source_mask_frame(d)
        v = np.clip((d - 1.0) * CUBE_SCALE, -30000, 30000).astype(np.int16)
        v[m] = MASKED
        cube[i] = v
        return i, med, float(m.mean())

    scales, keep, maskfrac, valid = [], [], [], []
    done = 0
    with cf.ThreadPoolExecutor(a.threads) as ex:
        for i, med, mf in ex.map(prepare, enumerate(sel)):
            done += 1
            if med is None:
                print(f'  skipped (no sky level): {os.path.basename(sel[i])}', file=sys.stderr)
                continue
            valid.append(i); scales.append(med); maskfrac.append(mf); keep.append(sel[i])
            if done % 50 == 0:
                print(f'  {done}/{len(sel)}  (last frame masked {100 * mf:.1f}%)')
    valid = np.array(sorted(valid))
    n = len(valid)
    if cube_path:
        cube.flush()
    print(f'  {n} frames, sky levels {np.min(scales):.1f} .. {np.max(scales):.1f} ADU '
          f'(median {np.median(scales):.1f})')
    print(f'  per-frame source mask: {100 * np.median(maskfrac):.1f}% of pixels '
          f'(median over frames), so every pixel is still covered by '
          f'~{n * (1 - np.median(maskfrac)):.0f} frames')

    bpm, bpm_frac = load_bpm(bpm_path) if bpm_path else (None, 0.0)
    if bpm is not None:
        print(f'  bad pixel map: {100 * bpm_frac:.2f}% of pixels masked and interpolated')
    out_dir = os.path.join(a.out_root, key, a.filter)

    coverage = {}

    def build_set(idx, tag):
        """median over the frames named by idx, in row bands from the cube"""
        print(f'\nbuilding {tag} from {len(idx)} frames:')
        rows = max(8, int(MASK_BAND / (max(1, len(idx)) * W * 4 * a.threads)))
        res = np.zeros((H, W), np.float32)
        cnt = np.zeros((H, W), np.int32)

        def do_band(y0):
            y1 = min(H, y0 + rows)
            res[y0:y1], cnt[y0:y1] = combine(cube[idx, y0:y1, :])
            return y1

        with cf.ThreadPoolExecutor(a.threads) as ex:
            for k, y1 in enumerate(ex.map(do_band, range(0, H, rows))):
                if k % 4 == 0:
                    print(f'  rows ..{y1:5} ({100 * y1 // H:3d}%)')
        floor = max(3, len(idx) // 10)
        thin = (cnt < floor) | ~np.isfinite(res)
        if thin.any():
            lab, nlab = ndimage.label(thin)
            big = max(ndimage.sum(thin, lab, range(1, nlab + 1))) if nlab else 0
            print(f'  thin coverage: {100 * thin.mean():.2f}% of pixels have fewer than '
                  f'{floor} frames (min {cnt.min()}); largest patch {int(big)} px '
                  f'- filled by smooth interpolation, NOT measured')
            res = smooth_fill(res, thin)
        if bpm is not None:
            res = smooth_fill(res, bpm, sigma=3)
        coverage[tag] = cnt
        res = res / float(np.mean(res))
        if not np.isfinite(res).all() or res.std() == 0:
            sys.exit(f'{tag}: the result is constant or not finite - refusing to write it')
        return res

    flat = build_set(valid, a.name)
    meta = dict(EQUIPKEY=key, FILTER=a.filter, NFRAMES=len(keep),
                NTARGETS=len({f.split('/Light')[0] for f in keep}),
                CLOCKING=round(ref, 3) if ref else 0, PIER=a.pier,
                NIGHTS=len({info[f]['night'] for f in keep}))
    write_out(os.path.join(out_dir, a.name + '.fits'), flat, meta, log)
    write_out(os.path.join(out_dir, a.name + '-coverage.fits'),
              coverage[a.name].astype(np.float32), meta, log)

    halves = None
    if a.halves:
        # split stratified by target and pier side, not by simple alternation:
        # residual sky flux lands 180 deg apart on the sensor for east and west
        # frames, so an unbalanced split shows up as an antisymmetric red/blue
        # pattern in the difference and inflates the apparent instability
        strata = defaultdict(list)
        for j, i in enumerate(valid):
            f = keep[j]
            strata[(f.split('/Light')[0], info[f]['pier'][0])].append(i)
        i1, i2 = [], []
        for k in sorted(strata):
            i1 += strata[k][0::2]
            i2 += strata[k][1::2]
        print(f'\nhalves stratified over {len(strata)} target/pier groups: '
              f'{len(i1)} vs {len(i2)} frames')
        h1 = build_set(np.array(sorted(i1)), a.name + '-half1')
        h2 = build_set(np.array(sorted(i2)), a.name + '-half2')
        write_out(os.path.join(out_dir, a.name + '-half1.fits'), h1, meta, log)
        write_out(os.path.join(out_dir, a.name + '-half2.fits'), h2, meta, log)
        d = h1 - h2
        print(f'\nSTABILITY: half1 - half2 rms {d.std():.6f} '
              f'({100 * d.std():.4f}% of unity), peak-to-peak {np.ptp(d):.6f}')
        print(f'           superflat structure rms {flat.std():.6f} '
              f'({100 * flat.std():.4f}%)  -> signal/instability '
              f'{flat.std() / d.std():.1f}x')
        halves = (h1, h2)
    if a.plot:
        plot(os.path.join(out_dir, a.name + '.png'), flat, halves, log,
             coverage.get(a.name))
    del cube
    if cube_path:
        os.unlink(cube_path)


if __name__ == '__main__':
    main()
