#!/usr/bin/env python3
"""subs-pull - fetch new sub exposures from the acquisition machine.

Pulls frames from the acquisition host (vostro) into the local archive
(~/astro/data) without dragging back frames that were already fetched AND
afterwards set aside - by sort-subs into <object>/Light_rejected/<Filter>/, or
by hand into <object>/Light/<Filter>/bad/. Plain rsync re-copies those forever,
because at their original path they are simply "missing" on this side.

HOW IT DECIDES WHAT IS NEW
  Every FITS file under the destination counts as "already have it", including
  the ones in aside locations. The frames sitting aside are turned into rsync
  exclude patterns (matched on file name, so it does not matter that the file
  now lives in Light_rejected/ instead of Light/). Everything else rsync sorts
  out by itself: files that are already in place with the same size and time
  are skipped, genuinely new ones are transferred.
  With --days / --since an extra include window on the date in the file name
  is applied, which only makes the transfer list shorter (and rsync faster) -
  it is not what keeps the rejected frames away.

Running it repeatedly during an imaging session is fine: a frame that was still
being written comes over short, and the next run replaces it (size and time
differ from the source). Only pitfall: do not sort such a partial frame aside
with sort-subs before the next pull, or the exclusion would keep the short copy.

SAFETY
  This is a one-way pull. It never deletes anything, here or there, and it
  refuses --delete: the acquisition host is a scratch area that gets cleaned
  out on purpose (files are kept there while a target is being imaged so that
  KStars keeps counting), while the local tree is the archive. Propagating
  deletions in this direction would erase the archive.

DRY RUN BY DEFAULT
  Nothing happens without --apply: no transfer, and no moves in the --sort
  stage either. --apply is the only switch that makes this run do something.

EXAMPLES
  subs-pull                          # dry run: what would come over from vostro:APM/
  subs-pull NGC_6285                 # only that target, still a dry run
  subs-pull NGC_6285 --apply         # transfer
  subs-pull NGC_6285 --apply --sort  # ... and sort the object afterwards
  subs-pull NGC_6285 --apply --sort --sort-arg "--plot --write"
  subs-pull NGC_6285 --apply --sort --sort-also-move-back
  subs-pull NGC_6285 NGC_6043 --days 3 --apply
  subs-pull --src vostro:APM/NGC_6285/Light/Lum/ --dest ~/astro/data/NGC_6285/Light/Lum/
  subs-pull NGC_6285 --days 3 -- --bwlimit=20M     # extra rsync options after --
"""

import argparse
import os
import re
import shlex
import subprocess
import sys
import time
import tempfile
from datetime import date, timedelta

SRC_ROOT = 'vostro:APM'
DEST_ROOT = os.path.expanduser('~/astro/data')
FITS_EXT = ('.fits', '.fit', '.fts')
ASIDE_NAMES = ('bad', 'rejected')
DATE_RE = re.compile(r'^(\d{4}-\d{2}-\d{2})T')
RSYNC_BASE = ['rsync', '-a', '-x', '--progress']
SORT_SUBS = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'sort-subs')


def is_aside(rel_dir):
    """True if this path (relative to the destination root) is an aside location:
    a <name>_rejected tree (sort-subs) or a bad/ or rejected/ subdir (by hand)."""
    for p in rel_dir.split(os.sep):
        if p.lower() in ASIDE_NAMES or p.endswith('_rejected'):
            return True
    return False


def newest_frame_age(obj):
    """Age in minutes of the most recently written frame under obj/Light, or None."""
    newest = 0.0
    for root, dirs, files in os.walk(os.path.join(obj, 'Light')):
        for f in files:
            if f.lower().endswith(FITS_EXT):
                newest = max(newest, os.path.getmtime(os.path.join(root, f)))
    return (time.time() - newest) / 60 if newest else None


def sort_object(dest, a, pull_applied):
    """Run sort-subs on the object that was just pulled into, if it is managed."""
    obj = dest.rstrip('/')
    if not (os.path.isdir(os.path.join(obj, 'Light')) or os.path.basename(obj) == 'Light'):
        print('  sort-subs skipped: not an object directory')
        return 0
    if not (os.path.exists(os.path.join(obj, 'sub-metrics.csv'))
            or os.path.isdir(os.path.join(obj, 'Light_rejected'))):
        print('  sort-subs skipped: this object is not sorted yet '
              '(no sub-metrics.csv, no Light_rejected/) - run sort-subs on it once by hand')
        return 0
    do_apply = pull_applied
    if not do_apply:
        print('  sort-subs: measure and report only (this run is a dry run)')
    if do_apply:
        age = newest_frame_age(obj)
        if age is not None and age < a.settle:
            print(f'  sort-subs: measure and report only - newest frame is {age:.0f} min old, '
                  f'less than --settle {a.settle} min (acquisition may still be running)')
            do_apply = False
    cmd = [SORT_SUBS, obj]
    if do_apply:
        cmd.append('--apply')
        if a.sort_also_move_back:
            cmd.append('--move-back')
    cmd += a.sort_arg
    print(f'  running: {" ".join(cmd)}')
    return subprocess.run(cmd).returncode


def glue_values(argv, names=('--sort-arg', '--rsync-arg')):
    """argparse refuses a value that starts with '-' (unless it contains a space),
    but these two options always take exactly such a value. Rewrite
    '--sort-arg --plot' into '--sort-arg=--plot' so both forms work."""
    out, i = [], 0
    while i < len(argv):
        if argv[i] in names and i + 1 < len(argv):
            out.append(f'{argv[i]}={argv[i + 1]}')
            i += 2
        else:
            out.append(argv[i])
            i += 1
    return out


def scan_dest(dest):
    """Return (total_frames, aside_basenames) for everything under dest."""
    total = 0
    aside = set()
    for root, dirs, files in os.walk(dest):
        rel = os.path.relpath(root, dest)
        names = [f for f in files if f.lower().endswith(FITS_EXT)]
        if not names:
            continue
        total += len(names)
        if rel != '.' and is_aside(rel):
            aside.update(names)
    return total, aside


def quote_pattern(name):
    """Escape rsync wildcard characters so a file name matches literally."""
    return re.sub(r'([*?\[\\])', r'\\\1', name)


def date_window(days, since):
    """List of YYYY-MM-DD strings to include, or None for 'no window'."""
    if not days and not since:
        return None
    today = date.today()
    start = date.fromisoformat(since) if since else today - timedelta(days=days - 1)
    if start > today:
        return []
    return [(start + timedelta(days=i)).isoformat()
            for i in range((today - start).days + 1)]


def build_pairs(a):
    if a.src or a.dest:
        if a.targets:
            sys.exit('give either target names or --src/--dest, not both')
        if not (a.src and a.dest):
            sys.exit('--src and --dest must be given together')
        return [(a.src.rstrip('/') + '/', os.path.expanduser(a.dest).rstrip('/') + '/')]
    if a.targets:
        return [(f'{a.src_root.rstrip("/")}/{t.strip("/")}/',
                 os.path.join(a.dest_root, t.strip('/')) + '/') for t in a.targets]
    return [(a.src_root.rstrip('/') + '/', a.dest_root.rstrip('/') + '/')]


def run(cmd, capture):
    if capture:
        return subprocess.run(cmd, capture_output=True, text=True)
    return subprocess.run(cmd, text=True)


def stat_line(out, key):
    for line in out.splitlines():
        if line.startswith(key):
            return line.split(':', 1)[1].strip()
    return '?'


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('targets', nargs='*',
                    help='object directories under the source root (default: the whole tree)')
    ap.add_argument('--apply', action='store_true',
                    help='the only switch that makes this run do anything: transfer the frames, '
                         'and with --sort also let sort-subs move rejects (default: dry run)')
    ap.add_argument('-n', '--dry-run', action='store_true',
                    help='accepted for habit; dry run is the default anyway')
    ap.add_argument('--days', type=int, metavar='N',
                    help='only consider frames whose file name date is within the last N days '
                         '(today = 1). Speeds up big trees; the aside exclusions work regardless')
    ap.add_argument('--since', metavar='YYYY-MM-DD',
                    help='only consider frames from this date onward')
    ap.add_argument('--src-root', default=SRC_ROOT, metavar='HOST:DIR',
                    help=f'source root for target names (default {SRC_ROOT})')
    ap.add_argument('--dest-root', default=DEST_ROOT, metavar='DIR',
                    help=f'destination root for target names (default {DEST_ROOT})')
    ap.add_argument('--src', metavar='HOST:DIR', help='explicit source (use with --dest)')
    ap.add_argument('--dest', metavar='DIR', help='explicit destination (use with --src)')
    ap.add_argument('-v', '--verbose', action='store_true', help='list the transferred files')
    ap.add_argument('--sort', action='store_true',
                    help='after the transfer run sort-subs on the object: measure the new frames '
                         'into <object>/sub-metrics.csv and report. With --apply it also moves '
                         'rejected frames to Light_rejected/, without it nothing moves. Only for '
                         'objects that are already sorted (sub-metrics.csv or Light_rejected/ '
                         'present)')
    ap.add_argument('--sort-also-move-back', action='store_true',
                    help='... and let sort-subs also move frames back into Light/ that the now '
                         'fuller night considers good (implies --sort; note it overrules frames '
                         'you rejected by hand into bad/)')
    ap.add_argument('--sort-arg', action='append', default=[], metavar='OPTS',
                    help='extra sort-subs options; split like a shell does, so several fit in '
                         'one string: --sort-arg "--plot --star-frac 0.4". Repeatable. Not '
                         'checked here, sort-subs sees them as given')
    ap.add_argument('--settle', type=int, default=60, metavar='MINUTES',
                    help='with --apply --sort: do not move anything while the newest frame is '
                         'younger than this, because the night is then only partly acquired and '
                         'the per-night statistics are still incomplete (default 60, 0 disables)')
    ap.add_argument('--refetch-rejected', action='store_true',
                    help='fetch rejected frames again: drop the exclusions, so everything that '
                         'sits in Light_rejected/ or bad/ is copied back into Light/ as well')
    ap.add_argument('--rsync-arg', action='append', default=[], metavar='OPTS',
                    help='extra rsync options, split like a shell does and repeatable, e.g. '
                         '--rsync-arg "--bwlimit=20M -v"; options after a literal -- work too')
    # split off everything after a standalone '--' before argparse sees it, so
    # that our own options keep working in front of it
    argv = sys.argv[1:]
    extra = []
    if '--' in argv:
        i = argv.index('--')
        argv, extra = argv[:i], argv[i + 1:]
    sys.stdout.reconfigure(line_buffering=True)   # keep our output in step with rsync/sort-subs
    a = ap.parse_args(glue_values(argv))
    # one string may carry several options: --sort-arg "--plot --star-frac 0.4"
    a.sort_arg = [w for s in a.sort_arg for w in shlex.split(s)]
    a.rsync_arg = [w for s in a.rsync_arg for w in shlex.split(s)]
    if a.sort_also_move_back:
        a.sort = True

    extra = a.rsync_arg + extra
    for x in extra + a.targets:
        if x.startswith('--delete'):
            sys.exit('subs-pull never deletes: the source is a scratch area that gets cleaned '
                     'out, the local tree is the archive.')

    window = date_window(a.days, a.since)
    if window is not None:
        print(f'date window: {window[0]} .. {window[-1]}' if window else 'date window: empty')

    rc = 0
    for src, dest in build_pairs(a):
        print(f'\n{src} -> {dest}')
        if os.path.isdir(dest):
            total, aside = scan_dest(dest)
            print(f'  already local: {total} frames ({len(aside)} set aside)')
        else:
            total, aside = 0, set()
            print('  new target (destination does not exist yet)')

        filters = []
        tmp = None
        if aside and not a.refetch_rejected:
            tmp = tempfile.NamedTemporaryFile('w', prefix='subs-pull-', suffix='.excl',
                                              delete=False)
            tmp.write('\n'.join(quote_pattern(n) for n in sorted(aside)) + '\n')
            tmp.close()
            filters.append(f'--exclude-from={tmp.name}')
        if window is not None:
            filters.append('--include=*/')
            filters += [f'--include={d}T*' for d in window]
            filters.append('--exclude=*')

        cmd = RSYNC_BASE + filters + extra + [src, dest]
        if a.verbose:
            cmd.insert(1, '-v')

        plan = run(cmd + ['-n', '--stats'], capture=True)
        if plan.returncode:
            print(plan.stdout[-2000:] + plan.stderr[-2000:], file=sys.stderr)
            rc = plan.returncode
        else:
            n = stat_line(plan.stdout, 'Number of regular files transferred')
            size = stat_line(plan.stdout, 'Total transferred file size')
            print(f'  to transfer: {n} frames, {size}')
            if not a.apply:
                if a.verbose:
                    print(plan.stdout)
            elif n not in ('0', '?'):
                r = run(cmd, capture=False)
                rc = r.returncode or rc
        if tmp:
            os.unlink(tmp.name)
        if a.sort:
            rc = sort_object(dest, a, a.apply) or rc

    if not a.apply:
        print('\n(dry run - use --apply to transfer)')
    sys.exit(rc)


if __name__ == '__main__':
    main()
